# Variables del frontend (Vite). Aquí NO van secretos: todo lo que empieza con
# VITE_ queda dentro de la página y cualquiera puede verlo.
#
# Para usar el backend en tu PC: copia este archivo como .env.local
# (no se sube a git) y deja VITE_DATA_SOURCE=api.

# De dónde salen los datos:
#   api   -> backend Django (pide login del profesor). Requiere el backend encendido.
#   local -> demo con datos de ejemplo guardados en el navegador (sin login).
VITE_DATA_SOURCE=api
