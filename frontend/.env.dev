# ------------------------------------------------------------------
# Entorno de DESARROLLO (npm run dev · npm run build:dev).
# Aquí NO van secretos: todo lo que empieza con VITE_ queda dentro de la página.
# Para cambiar algo solo en tu PC sin tocar este archivo: crea .env.dev.local.
# ------------------------------------------------------------------

# De dónde salen los datos:
#   api   -> backend Django (pide correo y clave de la tabla lector)
#   local -> demo con datos de ejemplo en el navegador (sin login, sin backend)
VITE_DATA_SOURCE=api

# Dirección de la API que usa la página. "/api" = la misma dirección de la página
# (en desarrollo Vite reenvía /api a BACKEND_URL).
VITE_API_URL=/api

# Solo en desarrollo: backend al que Vite reenvía /api (no queda dentro de la página).
BACKEND_URL=http://localhost:8000
