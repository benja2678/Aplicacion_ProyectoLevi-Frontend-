# ------------------------------------------------------------------
# Entorno de PRODUCCIÓN (npm run build -> carpeta dist/ para copiar al servidor).
# Aquí NO van secretos: todo lo que empieza con VITE_ queda dentro de la página.
# ------------------------------------------------------------------

# api = backend Django con login (en producción siempre api).
VITE_DATA_SOURCE=api

# Dirección de la API. "/api" = la misma dirección donde se publica la página
# (el servidor web reenvía /api al backend). Si el backend está en otra dirección,
# pon la completa, ej. https://laboratorio.uta.cl/api (el backend debe permitirlo: CORS).
VITE_API_URL=/api
